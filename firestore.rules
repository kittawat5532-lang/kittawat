rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && request.auth.token.email == 'kittawat5532@gmail.com';
    }

    function isAdmin() {
      return isSuperAdminEmail() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isModerator() {
      return isAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['moderator', 'admin']
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && (
        (incoming().role == 'member' && incoming().status == 'active') || isSuperAdminEmail()
      ) && incoming().uid == request.auth.uid;
      allow update: if (
        isOwner(userId) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'updatedAt'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // RESOURCES COLLECTION
    match /resources/{resourceId} {
      allow get: if resource.data.isHidden == false || (isSignedIn() && resource.data.authorId == request.auth.uid) || isModerator();
      allow list: if true;
      allow create: if isSignedIn() && 
        incoming().authorId == request.auth.uid &&
        incoming().title is string && incoming().title.size() >= 2 && incoming().title.size() <= 200 &&
        incoming().category is string && incoming().category.size() <= 100 &&
        incoming().gradeLevel is string && incoming().gradeLevel.size() <= 50;
      allow update: if (
        (isSignedIn() && resource.data.authorId == request.auth.uid && incoming().authorId == existing().authorId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'gradeLevel', 'mediaType', 'url', 'fileUrl', 'fileName', 'updatedAt']))
        ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['viewCount', 'favoriteCount', 'reportCount']))
        ||
        isModerator()
      );
      allow delete: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isModerator();
    }

    // FAVORITES COLLECTION
    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // REPORTS COLLECTION
    match /reports/{reportId} {
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow read, update, delete: if isModerator();
    }

    // MODERATION LOGS COLLECTION
    match /moderationLogs/{logId} {
      allow read: if isModerator();
      allow create: if isModerator() && incoming().performedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // SETTINGS COLLECTION
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ADMINS COLLECTION
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdminEmail();
    }
  }
}
